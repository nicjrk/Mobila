# Public Supabase configuration used by the browser client.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-public-key

# Server-side aliases used by TanStack Start/server utilities.
# Keep these out of VITE_* variables: VITE_* values are bundled for the browser.
SUPABASE_PROJECT_ID=your-project-ref
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-public-key

# Optional server-only admin key. Never expose this to the browser or commit it.
# SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
